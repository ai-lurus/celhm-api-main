generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Organization {
  id           Int                    @id @default(autoincrement())
  name         String
  slug         String                 @unique
  logo          String?             
  phone         String?             
  address       String?             
  email         String?             
  taxId         String?             
  website       String?             
  currency      String                @default("MXN") 
  timezone      String                @default("America/Mexico_City") 
  vatRate       Decimal               @default(0.16) @db.Decimal(10, 2) 
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  branches     Branch[]
  customers    Customer[]
  templates    NotificationTemplate[]
  users        OrgMembership[]
  defaultUsers User[]                 @relation("DefaultOrganization")
  
  @@map("organizations")
}

model OrgMembership {
  id             Int          @id @default(autoincrement())
  organizationId Int
  userId         Int
  role           Role
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("org_memberships")
}

model User {
  id                    Int             @id @default(autoincrement())
  authUserId            String?         @unique
  email                 String?         @unique
  name                  String?
  defaultOrganizationId Int?
  branchId              Int?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  password              String?
  cashCuts              CashCut[]
  movements             Movement[]
  memberships           OrgMembership[]
  payments              Payment[]
  sales                 Sale[]
  ticketHistory         TicketHistory[]
  tickets               Ticket[]
  branch                Branch?         @relation(fields: [branchId], references: [id])
  defaultOrganization   Organization?   @relation("DefaultOrganization", fields: [defaultOrganizationId], references: [id])

  @@map("users")
}

model Branch {
  id             Int             @id @default(autoincrement())
  organizationId Int
  code           String
  name           String
  address        String?
  phone          String?
  email          String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cashCuts       CashCut[]
  cashRegisters  CashRegister[]
  customers      Customer[]
  folioSequences FolioSequence[]
  movements      Movement[]
  sales          Sale[]
  stocks         Stock[]
  tickets        Ticket[]
  users          User[]

  @@unique([organizationId, code])
  @@map("branches")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  category    String?
  brand       String?
  model       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  variants    Variant[]

  @@index([deletedAt])
  @@map("products")
}

model Variant {
  id            Int          @id @default(autoincrement())
  productId     Int
  sku           String       @unique
  name          String?
  description   String?
  color         String?
  size          String?
  weight        Float?
  dimensions    String?
  price         Decimal?     @db.Decimal(10, 2)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  barcode       String?
  purchasePrice Decimal?     @db.Decimal(10, 2)
  deletedAt     DateTime?
  movements     Movement[]
  saleLines     SaleLine[]
  stocks        Stock[]
  ticketParts   TicketPart[]
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@map("variants")
}

model Stock {
  id        Int      @id @default(autoincrement())
  branchId  Int
  variantId Int
  qty       Int      @default(0)
  min       Int      @default(0)
  max       Int      @default(1000)
  reserved  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([branchId, variantId])
  @@map("stocks")
}

model Movement {
  id        Int          @id @default(autoincrement())
  branchId  Int
  variantId Int
  type      MovementType
  qty       Int
  reason    String?
  folio     String?
  ticketId  Int?
  userId    Int?
  ip        String?
  userAgent String?
  createdAt DateTime     @default(now())
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ticket    Ticket?      @relation(fields: [ticketId], references: [id])
  user      User?        @relation(fields: [userId], references: [id])
  variant   Variant      @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([branchId, createdAt])
  @@index([folio])
  @@map("movements")
}

model Customer {
  id             Int          @id @default(autoincrement())
  organizationId Int
  branchId       Int?
  name           String
  phone          String
  phoneAlt       String?
  rfc            String?
  email          String?
  notes          String?
  isWholesale    Boolean      @default(false)
  isCorporate    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales          Sale[]
  tickets        Ticket[]

  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@index([organizationId, name])
  @@index([deletedAt])
  @@map("customers")
}

model ProductCategory {
  id            Int               @id @default(autoincrement())
  name          String            @unique
  parentId      Int?
  parent        ProductCategory?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children      ProductCategory[] @relation("CategoryChildren")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("product_categories")
}

model DeviceBrand {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  models    DeviceModel[]

  @@map("device_brands")
}

model DeviceModel {
  id         Int         @id @default(autoincrement())
  brandId    Int
  name       String
  deviceType String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  brand      DeviceBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  tickets    Ticket[]

  @@unique([brandId, name])
  @@map("device_models")
}

model Ticket {
  id             Int             @id @default(autoincrement())
  branchId       Int
  folio          String          @unique
  customerName   String
  customerPhone  String?
  customerEmail  String?
  device         String
  brand          String?
  model          String?
  serialNumber   String?
  problem        String
  diagnosis      String?
  solution       String?
  state          TicketState     @default(RECIBIDO)
  estimatedCost  Decimal?        @db.Decimal(10, 2)
  finalCost      Decimal?        @db.Decimal(10, 2)
  estimatedTime  Int?
  warrantyDays   Int             @default(15)
  userId         Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  advancePayment Decimal?        @db.Decimal(10, 2)
  customerId     Int?
  imei           String?
  internalNotes  String?
  condition      String?
  accessories    String?
  risk           String?
  deletedAt      DateTime?
  deviceId       Int?
  movements      Movement[]
  sales          Sale[]
  history        TicketHistory[]
  parts          TicketPart[]
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id])
  deviceModel    DeviceModel?    @relation(fields: [deviceId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])

  @@index([branchId, state])
  @@index([folio])
  @@index([customerId])
  @@index([imei])
  @@index([deletedAt])
  @@map("tickets")
}

model TicketPart {
  id        Int             @id @default(autoincrement())
  ticketId  Int
  variantId Int
  qty       Int
  state     TicketPartState @default(RESERVADA)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  ticket    Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  variant   Variant         @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([ticketId, variantId])
  @@map("ticket_parts")
}

model TicketHistory {
  id        Int          @id @default(autoincrement())
  ticketId  Int
  fromState TicketState?
  toState   TicketState
  notes     String?
  userId    Int?
  ip        String?
  userAgent String?
  createdAt DateTime     @default(now())
  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_history")
}

model FolioSequence {
  id        Int      @id @default(autoincrement())
  branchId  Int
  prefix    String
  period    String
  seq       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([prefix, branchId, period])
  @@map("folio_sequences")
}

model NotificationTemplate {
  id             Int                 @id @default(autoincrement())
  organizationId Int
  channel        NotificationChannel
  code           String
  name           String
  bodyMdx        String
  locale         String              @default("es-MX")
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notifications  Notification[]

  @@unique([organizationId, channel, code])
  @@map("notification_templates")
}

model Notification {
  id         Int                   @id @default(autoincrement())
  templateId Int?
  channel    NotificationChannel
  recipient  String
  subject    String?
  body       String
  status     String                @default("pending")
  error      String?
  metadata   Json?
  createdAt  DateTime              @default(now())
  sentAt     DateTime?
  template   NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([status, createdAt])
  @@map("notifications")
}

model Sale {
  id         Int        @id @default(autoincrement())
  branchId   Int
  folio      String     @unique
  customerId Int?
  ticketId   Int?
  status     SaleStatus @default(PENDIENTE)
  subtotal   Decimal    @db.Decimal(10, 2)
  discount   Decimal    @default(0) @db.Decimal(10, 2)
  total      Decimal    @db.Decimal(10, 2)
  userId     Int?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  payments   Payment[]
  lines      SaleLine[]
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id])
  ticket     Ticket?    @relation(fields: [ticketId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id])
  cashRegisterId Int?
  cashCutId  Int?
  cashCut    CashCut?   @relation(fields: [cashCutId], references: [id])

  @@index([branchId, createdAt])
  @@index([folio])
  @@index([ticketId])
  @@index([customerId])
  @@index([deletedAt])
  @@index([cashCutId])
  @@map("sales")
}

model SaleLine {
  id          Int      @id @default(autoincrement())
  saleId      Int
  variantId   Int?
  description String
  qty         Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant     Variant? @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@map("sale_lines")
}

model Payment {
  id        Int           @id @default(autoincrement())
  saleId    Int
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  reference String?
  userId    Int?
  createdAt DateTime      @default(now())
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id])

  @@index([saleId])
  @@index([createdAt])
  @@map("payments")
}

model CashRegister {
  id        Int       @id @default(autoincrement())
  branchId  Int
  code      String
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  cuts      CashCut[]
  sales     Sale[]
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, code])
  @@map("cash_registers")
}

model CashCut {
  id             Int          @id @default(autoincrement())
  cashRegisterId Int
  branchId       Int
  date           DateTime     @db.Date
  openedAt       DateTime     @default(now())
  closedAt       DateTime?
  status         CashCutStatus @default(CLOSED)
  initialAmount  Decimal      @default(0) @db.Decimal(10, 2)
  salesCash      Decimal      @default(0) @db.Decimal(10, 2)
  salesDebitCard Decimal      @default(0) @db.Decimal(10, 2)
  salesCreditCard Decimal      @default(0) @db.Decimal(10, 2)
  salesTransfer  Decimal      @default(0) @db.Decimal(10, 2)
  advances       Decimal      @default(0) @db.Decimal(10, 2)
  adjustments    Decimal      @default(0) @db.Decimal(10, 2)
  declaredAmount Decimal      @default(0) @db.Decimal(10, 2)
  declaredDebitCard Decimal?  @default(0) @db.Decimal(10, 2)
  declaredCreditCard Decimal? @default(0) @db.Decimal(10, 2)
  declaredTransfer Decimal?   @default(0) @db.Decimal(10, 2)
  expectedAmount Decimal      @default(0) @db.Decimal(10, 2)
  difference     Decimal      @default(0) @db.Decimal(10, 2)
  totalIncome    Decimal      @db.Decimal(10, 2)
  finalAmount    Decimal      @db.Decimal(10, 2)
  notes          String?
  userId         Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])
  sales          Sale[]

  @@index([branchId, date])
  @@map("cash_cuts")
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  organizationId Int?
  branchId       Int?
  userId         Int?
  action         String
  entityName     String
  entityId       String?
  oldValue       Json?
  newValue       Json?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([entityName, entityId])
  @@map("audit_logs")
}

enum Role {
  ADMON
  LABORATORIO
  ADMINISTRADOR
  RECEPCIONISTA
}

enum TicketState {
  RECIBIDO
  DIAGNOSTICO
  ESPERANDO_PIEZA
  EN_REPARACION
  REPARADO
  ENTREGADO
  CANCELADO
}

enum MovementType {
  ING
  EGR
  VTA
  AJU
  TRF_OUT
  TRF_IN
}

enum TicketPartState {
  RESERVADA
  CONSUMIDA
  LIBERADA
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_DEBITO
  TARJETA_CREDITO
  TRANSFERENCIA
  CHEQUE
  OTRO
}

enum SaleStatus {
  PENDIENTE
  PAGADO
  CANCELADO
}

enum CashCutStatus {
  OPEN
  CLOSED
}

